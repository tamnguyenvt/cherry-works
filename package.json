{
  "name": "cherry-works",
  "version": "0.0.0",
  "description": "The charter engine: resolves a charter and compiles it into what a coding agent reads.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.2.1",
  "bin": {
    "cw": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#hexagon/*": "./src/hexagon/*",
    "#portal/*": "./dist/portal/*"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/driver/portal/page",
    "test": "pnpm run lint:deps && pnpm run build && node --import tsx --test \"test/**/*.test.ts\"",
    "cw": "node --import tsx main.ts",
    "lint:deps": "depcruise src main.ts",
    "specs:link": "node --import tsx scripts/link-specs.ts",
    "specs:check": "node --import tsx scripts/link-specs.ts --check"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.3",
    "@types/prompts": "^2.4.9",
    "@types/yargs": "^17.0.35",
    "dependency-cruiser": "^18.2.0",
    "playwright": "^1.63.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.13",
    "picomatch": "^4.0.7",
    "preact": "^10.29.8",
    "prompts": "^2.4.2",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0",
    "zod": "^4.6.1"
  }
}
