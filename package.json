{
  "name": "cherry-works",
  "version": "0.5.0",
  "description": "The charter engine: resolves a charter and compiles it into what a coding agent reads.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "charter",
    "ai-agents",
    "cli",
    "guardrails"
  ],
  "homepage": "https://github.com/tamnguyenvt/cherry-works#readme",
  "bugs": {
    "url": "https://github.com/tamnguyenvt/cherry-works/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamnguyenvt/cherry-works.git"
  },
  "license": "MIT",
  "author": "Tam Nguyen",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.2.1",
  "bin": {
    "cw": "./dist/cw.js"
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#hexagon/*": "./src/hexagon/*",
    "#portal/*": "./dist/portal/*"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i src/driver/portal/page/styles.css -o dist/portal/styles.css --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/driver/portal/page",
    "test": "pnpm run lint:deps && pnpm run build && node --import tsx --import ./scripts/moduleLoader.mjs --test \"test/**/*.test.ts\"",
    "cw": "node --import tsx --import ./scripts/moduleLoader.mjs main.ts",
    "lint:deps": "depcruise src main.ts",
    "release": "node --import tsx scripts/release.ts",
    "prepublishOnly": "node -e \"console.error('Publish with \\\"pnpm release <version>\\\", which checks the package first.'); process.exit(1)\""
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^4.0.3",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dependency-cruiser": "^18.2.0",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "promptfoo": "0.123.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.7",
    "js-tiktoken": "^1.0.21",
    "picomatch": "^4.0.7",
    "prompts": "^2.4.2",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0",
    "zod": "^4.6.1"
  }
}
