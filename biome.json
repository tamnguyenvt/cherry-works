{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.cw",
      "!specs",
      "!contract",
      "!contract.d.ts",
      "!**/*.md",
      "!**/*.html",
      "!src/module/charter/domain/builtin/scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off",
        "useLiteralKeys": "off",
        "noCommaOperator": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["src/presentation/portal/page/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    }
  ]
}
